{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "controlPlane": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["", "sqlite", "postgres", "mysql", "mongodb"] },
            "url": { "type": "string" },
            "urlFrom": { "type": "object" },
            "existingSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "urlKey": { "type": "string" }
              }
            },
            "sqlite": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "mode": { "type": "string", "enum": ["", "ro", "rw", "rwc", "memory"] }
              }
            },
            "host": { "type": "string" },
            "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "name": { "type": "string" },
            "username": { "type": "string" },
            "usernameFrom": { "type": "object" },
            "password": { "type": "string" },
            "passwordFrom": { "type": "object" },
            "existingCredentialsSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "usernameKey": { "type": "string" },
                "passwordKey": { "type": "string" }
              }
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "integer", "boolean"]
              }
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adminJwtSecret": { "$ref": "#/definitions/secretSource" },
            "cpDpGrpcJwtSecret": { "$ref": "#/definitions/secretSource" }
          }
        },
        "probes": { "$ref": "#/definitions/workloadProbes" }
      }
    },
    "injector": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "probes": { "$ref": "#/definitions/workloadProbes" }
      }
    },
    "ambient": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "probes": { "$ref": "#/definitions/workloadProbes" }
      }
    },
    "eastWest": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "probes": { "$ref": "#/definitions/workloadProbes" }
      }
    },
    "ca": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "probes": { "$ref": "#/definitions/workloadProbes" }
      }
    },
    "nodeAgent": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "probes": { "$ref": "#/definitions/workloadProbes" }
      }
    }
  },
  "definitions": {
    "secretSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "existingSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "valueFrom": { "type": "object" }
      }
    },
    "workloadProbes": {
      "type": "object",
      "description": "Per-workload health probes. Where an admin listener exists, liveness/startup use `ferrum-edge health --live` (GET /live) and readiness uses `ferrum-edge health` (GET /health). Injector/east-west defaults use a TCP probe on their listen port. Overrides are per-probe so liveness and readiness cannot be silently coupled.",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "failureThreshold": { "type": "integer", "minimum": 1 },
            "periodSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "override": {
              "type": "object",
              "description": "Custom liveness handler (exec/httpGet/tcpSocket) replacing the computed default; also used by the startup probe."
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "override": {
              "type": "object",
              "description": "Custom readiness handler (exec/httpGet/tcpSocket) replacing the computed default."
            }
          }
        }
      }
    }
  }
}
