{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ferrum-gateway values",
  "type": "object",
  "required": ["mode", "image"],
  "properties": {
    "mode": {
      "type": "string",
      "description": "Core gateway operating mode. mesh/injector/node_agent live in the ferrum-mesh chart.",
      "enum": ["database", "file", "cp", "dp"]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": { "type": "array" }
      }
    },
    "shutdownDrainSeconds": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "ports": {
      "type": "object",
      "properties": {
        "proxyHttp": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "proxyHttps": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "adminHttp": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "adminHttps": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "cpGrpc": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "streamPorts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "containerPort"],
        "properties": {
          "name": { "type": "string" },
          "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "type": "string", "enum": ["TCP", "UDP"] },
          "service": { "type": "boolean" },
          "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["", "sqlite", "postgres", "mysql", "mongodb"] }
      }
    },
    "probes": {
      "type": "object",
      "description": "Health probes. Liveness/startup use `ferrum-edge health --live` (GET /live); readiness uses `ferrum-edge health` (GET /health). Overrides are per-probe so liveness and readiness cannot be silently coupled.",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "failureThreshold": { "type": "integer", "minimum": 1 },
            "periodSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "liveness": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "override": {
              "type": "object",
              "description": "Custom liveness handler (exec/httpGet/tcpSocket) replacing the computed /live check; also used by the startup probe."
            }
          }
        },
        "readiness": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "initialDelaySeconds": { "type": "integer", "minimum": 0 },
            "periodSeconds": { "type": "integer", "minimum": 1 },
            "override": {
              "type": "object",
              "description": "Custom readiness handler (exec/httpGet/tcpSocket) replacing the computed /health check."
            }
          }
        }
      }
    }
  }
}
